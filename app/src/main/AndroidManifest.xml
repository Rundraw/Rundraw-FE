<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_rundraw_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_rundraw_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.RundrawFE"
        tools:targetApi="31"
        android:usesCleartextTraffic="true">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- 앱 시작 Activity (MainActivity) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- OAuth Redirect -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="rundraw" android:host="login"/>
            </intent-filter>
        </activity>

        <!-- 주요 화면 -->
        <activity android:name=".SignActivity" android:exported="false" />
        <activity android:name=".HomeActivity" android:exported="false" />
        <activity android:name=".RankingActivity" android:exported="false" />

        <!-- 마이페이지 관련 화면 -->
        <activity android:name=".mypage.MyPageActivity" android:exported="false" />
        <activity android:name=".mypage.MyPageCommentsActivity" android:exported="false" />
        <activity android:name=".mypage.MyPageCoursesActivity" android:exported="false" />
        <activity android:name=".mypage.MyPageScrapActivity" android:exported="false" />
        <activity android:name=".mypage.MyPageDrawnActivity" android:exported="false" />

        <!-- 코스 설정 화면 -->
        <activity android:name=".mypage.CourseSettingActivity" android:exported="false" />
        <!-- TODO: 실제 사용 여부 및 진행 상황 팀원과 재확인 -->
        <activity android:name=".mypage.MyPageCourseDetailActivity" android:exported="false" />

        <!-- 경로 설정 진입 화면 -->
        <activity android:name=".CourseHomeActivity" android:exported="false" />

        <!-- 코스 검색 상세 화면 -->
        <activity android:name=".CourseSearchActivity" android:exported="false" />

        <!-- 코스 상세 화면 -->
        <activity android:name=".CourseDetailActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>

        <!-- 코스 그리기 화면 -->
        <activity android:name=".DrawCourseActivity" android:exported="false" />

        <!-- 네비게이션 준비 화면 -->
        <activity
            android:name=".NavigateActivity"
            android:exported="false">
        </activity>

        <activity
            android:name=".GpsArtActivity"
            android:exported="false">
        </activity>

        <!-- 맛집 화면 -->
        <activity android:name=".RestaurantActivity" android:exported="false" />

    </application>
</manifest>