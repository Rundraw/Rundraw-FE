<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_rundraw_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_rundraw_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.RundrawFE"
        tools:targetApi="31"
        android:usesCleartextTraffic="true">
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${GOOGLE_MAP_KEY}" />
        <!-- 앱 시작 Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 회원가입 화면 -->
        <activity
            android:name=".SignActivity"
            android:exported="false" />

        <!-- 홈 화면 -->
        <activity
            android:name=".HomeActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="login"
                    android:scheme="rundraw" />
            </intent-filter>
        </activity>

        <!-- 랭킹 화면 -->
        <activity
            android:name=".RankingActivity"
            android:exported="false" />

        <!-- 경로 설정 진입 화면 -->
        <activity android:name=".CourseHomeActivity" android:exported="false" />

        <!-- 코스 검색 상세 화면 -->
        <activity android:name=".CourseSearchActivity" android:exported="false" />

        <!-- 코스 상세 화면 -->
        <activity android:name=".CourseDetailActivity" android:exported="false" />

        <!-- 코스 그리기 화면 -->
        <activity
            android:name=".DrawCourseActivity" android:exported="false" />

        <!-- 네비게이션 준비 화면 -->
        <activity
            android:name=".NavigateActivity"
            android:exported="false">
        </activity>

        <!-- 맛집 화면 -->
        <activity android:name=".RestaurantActivity" android:exported="false" />
    </application>

</manifest>