<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">


    <!-- 난이도 선택 -->
    <LinearLayout
        android:id="@+id/levelLayout"
        android:layout_width="match_parent"
        android:layout_height="40dp"

        android:orientation="horizontal"

        android:gravity="center"

        android:layout_marginTop="20dp"
        android:paddingHorizontal="40dp"

        app:layout_constraintTop_toTopOf="parent">


        <TextView
            android:id="@+id/beginnerLevel"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"

            android:gravity="center"

            android:text="상급"
            android:textSize="14sp"

            android:background="@drawable/level_unselected"/>


        <TextView
            android:id="@+id/middleLevel"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"

            android:gravity="center"

            android:text="중급"
            android:textSize="14sp"

            android:background="@drawable/level_unselected"/>


        <TextView
            android:id="@+id/highLevel"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"

            android:gravity="center"

            android:text="하급"
            android:textSize="14sp"

            android:textColor="@android:color/white"

            android:background="@drawable/level_selected"/>


    </LinearLayout>


    <!-- 코스 리스트 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/collectRecyclerView"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:paddingTop="20dp"

        app:layout_constraintTop_toBottomOf="@id/levelLayout"
        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>