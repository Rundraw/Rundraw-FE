<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- 로고 -->
    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:src="@drawable/ic_rundraw_logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/loginText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- 안내문 -->
    <TextView
        android:id="@+id/loginText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="간편하게 로그인 하고&#10;다양한 서비스를 이용해보세요."
        android:textColor="#333333"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/logoImage"
        app:layout_constraintBottom_toTopOf="@id/kakaoButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 카카오 로그인 버튼 -->

    <!-- 회원가입 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/kakaoButton"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="48dp"
        android:backgroundTint="#FEE500"
        android:text="카카오로 로그인 하기"
        android:textColor="#000000"
        android:textStyle="bold"
        android:textSize="20sp"
        app:cornerRadius="32dp"
        app:icon="@drawable/ic_kakao_logo"
        app:iconTint="@null"
        app:iconSize="29dp"
        app:iconGravity="textStart"
        app:iconPadding="16dp"
        app:layout_constraintTop_toBottomOf="@id/loginText"
        app:layout_constraintBottom_toTopOf="@id/signupText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/signupText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="16dp"
        android:text="회원가입하기"
        android:textColor="#A0A0A0"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/kakaoButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>