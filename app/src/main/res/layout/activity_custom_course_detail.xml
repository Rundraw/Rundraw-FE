<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F8"
    android:padding="20dp">

    <!-- 상단바 영역 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <!-- 공유 아이콘 -->
        <ImageView
            android:id="@+id/imgShareBtn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_share"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="공유" />

        <!-- 중앙 타이틀 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerInParent="true"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RunDraw"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#0066FF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="내 코스"
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 설정 아이콘 -->
        <ImageView
            android:id="@+id/imgSettingBtn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_settings"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="설정" />
    </RelativeLayout>

    <!-- 지도 / 코스 그림 영역 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:background="@drawable/bg_custom_map_box_mypage"
        android:layout_marginBottom="16dp"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="사용자 그린 코스 (수정X)"
            android:textColor="#666666"
            android:textSize="13sp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp" />
    </FrameLayout>

    <!-- 하단 정보 입력 및 버튼 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3"
        android:orientation="vertical"
        android:background="@drawable/bg_custom_card_box_mypage"
        android:padding="20dp"
        android:elevation="4dp">

        <!-- 코스 이름 레이블 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="코스 이름"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginBottom="6dp" />

        <!-- 코스 이름 입력 박스 -->
        <EditText
            android:id="@+id/editCourseTitle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_custom_input_field_mypage"
            android:text="얼굴 코스"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:paddingHorizontal="16dp"
            android:inputType="text"
            android:layout_marginBottom="14dp" />

        <!-- 거리 레이블 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="거리"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginBottom="6dp" />

        <!-- 거리 표시 박스 -->
        <TextView
            android:id="@+id/textCourseLength"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_custom_input_field_mypage"
            android:text="1.19km"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0066FF"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp" />

        <!-- 경로 안내 버튼 -->
        <Button
            android:id="@+id/btnStartNavigation"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="경로 안내"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#78A684"
            style="?android:attr/borderlessButtonStyle" />

    </LinearLayout>

</LinearLayout>