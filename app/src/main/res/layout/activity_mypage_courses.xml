<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 여기 추가 -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_back"
        app:layout_constraintTop_toTopOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="@id/toolbar"/>

    <TextView
        android:id="@+id/tvToolbarTitle"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:gravity="center"
        android:text="코스 모아보기"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold"

        app:layout_constraintTop_toTopOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 완주 코스 -->
    <TextView
        android:id="@+id/tabCompleted"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="완주 코스"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tabExperience"
        app:layout_constraintHorizontal_weight="1"/>

    <!-- 체험한 코스 -->
    <TextView
        android:id="@+id/tabExperience"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginEnd="28dp"
        android:gravity="center"
        android:text="체험한 코스"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/tabCompleted"
        app:layout_constraintBottom_toBottomOf="@id/tabCompleted"
        app:layout_constraintStart_toEndOf="@id/tabCompleted"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"/>

    <!-- 선택된 탭 밑줄 -->
    <View
        android:id="@+id/tabUnderline"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="#4084D8"
        app:layout_constraintTop_toBottomOf="@id/tabCompleted"
        app:layout_constraintStart_toStartOf="@id/tabCompleted"
        app:layout_constraintEnd_toEndOf="@id/tabCompleted"/>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCourses"
        android:layout_width="350dp"
        android:layout_height="450dp"

        android:layout_marginTop="10dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="5dp"

        android:background="@drawable/bg_round_white"
        android:elevation="5dp"
        android:translationZ="8dp"
        android:clipToPadding="false"

        app:layout_constraintTop_toBottomOf="@id/tabUnderline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>