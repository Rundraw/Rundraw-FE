<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_page"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="25dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- 페이지 타이틀 -->
        <TextView
            android:id="@+id/memberName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="솔순님, 반가워요!"
            android:textSize="16sp"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="#000000"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="오늘도 나만의 그림을 따라 달려볼까요?"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- 내 경로 보기 섹션 헤더 -->
        <LinearLayout
            android:id="@+id/sectionMyRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="내 경로 보기"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#000000" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="더보기"
                android:textSize="15sp"
                android:drawableEnd="@drawable/ic_more_btn"
                android:textColor="#666666"/>
        </LinearLayout>

        <!-- 내 경로 카드 리스트 (RecyclerView로 교체 가능) -->
        <LinearLayout
            android:id="@+id/myRouteContainer"
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@drawable/bg_round_white"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:elevation="4dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginBottom="16dp">

            <!-- 카드 1 (완료 - 초록) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#ffffff"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="16dp">
                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/dot_green" />
            </RelativeLayout>

            <!-- 카드 2 (완료 - 초록) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#ffffff"
                android:layout_marginBottom="8dp">
                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/dot_green" />
            </RelativeLayout>

            <!-- 카드 3 (미완료 - 빨강) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#ffffff"
                android:layout_marginBottom="16dp">
                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/dot_red" />
            </RelativeLayout>
        </LinearLayout>

        <!-- 내가 저장한 맛집 섹션 헤더 -->
        <LinearLayout
            android:id="@+id/sectionMyRestaurant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="내가 저장한 맛집"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#000000"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="더보기"
                android:textSize="15sp"
                android:drawableEnd="@drawable/ic_more_btn"
                android:textColor="#666666"/>
        </LinearLayout>

        <!-- 맛집 카드 -->
        <LinearLayout
            android:id="@+id/layoutRestaurantCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginBottom="16dp">


            <!-- 카드 1 -->
            <LinearLayout
                android:id="@+id/restaurantCard1"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:padding="10dp"
                android:elevation="2dp"
                android:background="@drawable/bg_round_white">


                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:src="@drawable/img_restaurant" />


                <TextView
                    android:id="@+id/tvRestaurantName1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="맛집 1"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:gravity="center"/>


                <TextView
                    android:id="@+id/tvRestaurantCourse1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="한강 러닝 코스"
                    android:textSize="11sp"
                    android:textColor="#0D51A5"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:layout_marginTop="6dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_course_tag"/>

            </LinearLayout>



            <!-- 카드 2 -->
            <LinearLayout
                android:id="@+id/restaurantCard2"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:padding="10dp"
                android:elevation="2dp"
                android:background="@drawable/bg_round_white">


                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:src="@drawable/img_restaurant" />


                <TextView
                    android:id="@+id/tvRestaurantName2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="맛집 2"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:gravity="center"/>


                <TextView
                    android:id="@+id/tvRestaurantCourse2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="한강 러닝 코스"
                    android:textSize="11sp"
                    android:textColor="#0D51A5"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:layout_marginTop="6dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_course_tag"/>

            </LinearLayout>



            <!-- 카드 3 -->
            <LinearLayout
                android:id="@+id/restaurantCard3"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="10dp"
                android:elevation="2dp"
                android:background="@drawable/bg_round_white">


                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:src="@drawable/img_restaurant" />


                <TextView
                    android:id="@+id/tvRestaurantName3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="맛집 3"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:gravity="center"/>


                <TextView
                    android:id="@+id/tvRestaurantCourse3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="한강 러닝 코스"
                    android:textSize="11sp"
                    android:textColor="#0D51A5"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:layout_marginTop="6dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_course_tag"/>

            </LinearLayout>


        </LinearLayout>

        <!-- 인기 GPS ART 섹션 헤더 -->
        <LinearLayout
            android:id="@+id/sectionGpsArt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="인기 GPS ART"
                android:textSize="18sp"
                android:textColor="#000000"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="더보기"
                android:textSize="15sp"
                android:drawableEnd="@drawable/ic_more_btn"
                android:textColor="#666666"/>
        </LinearLayout>

        <!-- GPS ART 가로 이미지 리스트 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/gpsArtRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>


    </LinearLayout>
</androidx.core.widget.NestedScrollView>